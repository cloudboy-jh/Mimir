+	it("exposes exact spawning sessions to extensions without confusing roots, siblings or grandchildren", async () => {
+		const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "omp-parent-session-"));
+		tempDirs.push(tempDir);
+		const registry = new AgentRegistry();
+		const sessions: AgentSession[] = [];
+		const observed = new Map<string, string | null | undefined>();
+		const spawn = async (id: string, parentAgentId?: string) => {
+			const { session } = await createAgentSession({
+				cwd: tempDir, agentDir: path.join(tempDir, "agent"),
+				modelRegistry: sharedModelRegistry, settings: Settings.isolated(),
+				sessionManager: SessionManager.inMemory(tempDir),
+				disableExtensionDiscovery: true, skills: [], contextFiles: [],
+				promptTemplates: [], slashCommands: [], toolNames: [],
+				enableMCP: false, enableLsp: false, agentRegistry: registry,
+				agentId: id, parentAgentId, taskDepth: parentAgentId ? 1 : 0,
+				extensions: [pi => {
+					pi.on("session_start", (_event, ctx) => {
+						observed.set(id, ctx.parentSessionId);
+					});
+				}],
+			});
+			sessions.push(session);
+			await session.extensionRunner?.emit({ type: "session_start" });
+			return session;
+		};
+		try {
+			const root = await spawn("Root");
+			const child = await spawn("Child", "Root");
+			await spawn("Sibling", "Root");
+			await spawn("Grandchild", "Child");
+			await spawn("Independent");
+			expect(Object.fromEntries(observed)).toEqual({
+				Root: null,
+				Child: root.sessionManager.getSessionId(),
+				Sibling: root.sessionManager.getSessionId(),
+				Grandchild: child.sessionManager.getSessionId(),
+				Independent: null,
+			});
+			const originalParent = observed.get("Child");
+			await root.sessionManager.newSession();
+			await child.extensionRunner?.emit({ type: "session_start" });
+			expect(observed.get("Child")).toBe(originalParent);
+		} finally {
+			for (const session of sessions.reverse()) await session.dispose();
+		}
+	});
