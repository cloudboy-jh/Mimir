{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "mimir _hook cursor" }],
    "beforeSubmitPrompt": [{ "command": "mimir _hook cursor" }],
    "preCompact": [{ "command": "mimir _hook cursor" }],
    "afterShellExecution": [{ "command": "mimir _hook cursor", "matcher": "git\\s+commit" }],
    "afterAgentResponse": [{ "command": "mimir _hook cursor" }],
    "stop": [{ "command": "mimir _hook cursor" }],
    "sessionEnd": [{ "command": "mimir _hook cursor" }]
  }
}
