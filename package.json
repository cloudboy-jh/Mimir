{
  "name": "mimir",
  "private": true,
  "packageManager": "bun@1.3.1",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-dashboard.ts",
    "dev:live": "bun scripts/dev-dashboard.ts --live",
    "dev:web": "bun --cwd=worker/web run dev",
    "dev:api": "bun --cwd=worker run dev:api",
    "build": "bun --cwd=worker/web run build",
    "build:demo": "bun --cwd=worker/web run build:demo",
    "check:demo-assets": "bun scripts/check-demo-assets.ts",
    "verify:dashboard-builds": "bun scripts/verify-dashboard-builds.ts",
    "typecheck": "bun --cwd=worker/web run typecheck",
    "typecheck:plugins": "tsc -p plugins/opencode/tsconfig.json",
    "test:plugins": "bun test plugins/opencode/"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.4.6",
    "@types/bun": "^1.3.14",
    "@types/node": "24.0.0",
    "typescript": "5.8.3"
  }
}
